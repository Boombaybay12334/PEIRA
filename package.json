{
  "name": "peira",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:qa": "PEIRA_BUILD_DIR=dist-qa PEIRA_INCLUDE_DRAFTS=1 astro build",
    "preview": "astro preview",
    "preview:qa": "PEIRA_BUILD_DIR=dist-qa astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:colors": "node scripts/check-colors.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:build-output": "vitest run tests/build-output.test.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:build-output": "node scripts/check-build-output.mjs",
    "new:essay": "node scripts/new-essay.mjs",
    "essay:status": "node scripts/essay-status.mjs",
    "author": "pnpm essay:status",
    "essay:check": "node scripts/essay-check.mjs",
    "preview:phone": "node scripts/preview-phone.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "astro": "astro",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.6",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "maplibre-gl": "^6.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
