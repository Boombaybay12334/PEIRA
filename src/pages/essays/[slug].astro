---
import { render, type CollectionEntry } from "astro:content";

import Corrections from "../../components/Corrections.astro";
import Figure from "../../components/Figure.astro";
import LabPanel from "../../components/LabPanel.astro";
import { getPublishedEssays } from "../../content/queries";
import EssayLayout from "../../layouts/EssayLayout.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readingTime } from "../../lib/reading-time";

const publishedEssays = await getPublishedEssays();

export async function getStaticPaths() {
  const essays = await getPublishedEssays();

  return essays.map((essay) => ({
    params: { slug: essay.data.slug },
    props: { essay },
  }));
}

interface Props {
  essay: CollectionEntry<"essays">;
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<SiteLayout
  title={`${essay.data.title} — PEIRA`}
  description={essay.data.description}
  publishedEssayCount={publishedEssays.length}
>
  <EssayLayout essay={essay} readingMinutes={readingTime(essay.body ?? "")}>
    <Fragment slot="hero">
      <Figure
        src={essay.data.heroImage.src}
        alt={essay.data.heroImage.alt}
        caption={essay.data.heroImage.caption}
        credit={essay.data.heroImage.credit}
        license={essay.data.heroImage.license}
        loading="eager"
        page={`/essays/${essay.data.slug}`}
      />
    </Fragment>
    <Content />
    <Fragment slot="lab">
      <LabPanel repoUrl={essay.data.repoUrl} lab={essay.data.lab} />
    </Fragment>
    <Fragment slot="corrections">
      <Corrections corrections={essay.data.corrections} />
    </Fragment>
  </EssayLayout>
</SiteLayout>
